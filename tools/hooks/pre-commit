#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0-or-later
# Repo policy check, installed as .git/hooks/pre-commit by tools/install_hooks.sh.
#   1. identity (only when `git config bb.enforceIdentity true`, set by --maintainer)
#   2. local-only files are never committed (AGENTS.md, CLAUDE.md, notes/, SESSION*.md,
#      KICKOFF*.md, and the patterns in `git config --get-all bb.localOnly`)
#   3. no game data (tools/check_no_game_data.py --staged)
#   4. functions.csv, hooks.csv and the README progress block agree with the staged tree
#   5. catalogue parses (tools/check_catalogue.py): no raw csv.DictReader outside its allowlist and
#      no explicit size radix; the allowlist only shrinks, in both directions
#   6. game/ is readable (tools/check_readable.py, STYLE.md); its allowlist only shrinks
#
# A gate that exists and is not invoked here is a gate nobody runs: progress.py prints the SAME
# DictReader count as a summary line, and for one slice that number read like the verdict while the
# verdict itself never ran.
# Installed as commit-msg too: lines matching `git config --get-all bb.refuseMessage` (extended
# regular expressions, case-insensitive) are refused, and every value of
# `git config --get-all bb.requireMessage` (literal, case-insensitive) must appear in the message.
# CONTRIBUTING.md, "AI-assisted work", requires a Co-Authored-By trailer naming the tool actually
# used and says not to rewrite existing commits to add disclosure -- so a clone that always
# commits with assistance can set the trailer as required and stop relying on remembering it:
#   git config --add bb.requireMessage 'Co-Authored-By: Claude'
set -euo pipefail

if [ "${BB_HOOK_NAME:-$(basename "$0")}" = "commit-msg" ]; then
    hits=""
    while IFS= read -r pattern; do
        [ -n "$pattern" ] || continue
        hits+=$(grep -v '^#' "$1" | grep -inE -- "$pattern" || true)
    done < <(git config --get-all bb.refuseMessage || true)
    if [ -n "$hits" ]; then
        echo "commit-msg: refused by bb.refuseMessage:" >&2
        echo "$hits" >&2
        exit 1
    fi
    missing=""
    while IFS= read -r required; do
        [ -n "$required" ] || continue
        if ! grep -v '^#' "$1" | grep -qiF -- "$required"; then
            missing+="  $required"$'\n'
        fi
    done < <(git config --get-all bb.requireMessage || true)
    if [ -n "$missing" ]; then
        echo "commit-msg: the message must contain (bb.requireMessage):" >&2
        printf '%s' "$missing" >&2
        exit 1
    fi
    exit 0
fi

IDENT=$(git config --get bb.maintainerIdent || true)
root=$(git rev-parse --show-toplevel)

fail() { echo "pre-commit: $*" >&2; exit 1; }

if [ "$(git config --get bb.enforceIdentity || true)" = "true" ]; then
    [ -n "$IDENT" ] || fail "bb.maintainerIdent is not set (run tools/install_hooks.sh --maintainer)"
    for var in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
        who=$(git var "$var" | sed -E 's/ [0-9]+ [+-][0-9]{4}$//')
        [ "$who" = "$IDENT" ] || fail "$var is '$who', expected '$IDENT'"
    done
fi

staged=$(git diff --cached --name-only --diff-filter=ACMR)
local_only='AGENTS\.md|CLAUDE\.md|\.claude/|notes/|SESSION[^/]*\.md|KICKOFF[^/]*\.md'
while IFS= read -r pattern; do [ -n "$pattern" ] && local_only+="|$pattern"; done < <(git config --get-all bb.localOnly || true)
bad=$(printf '%s\n' "$staged" | grep -E "(^|/)($local_only)" || true)
[ -z "$bad" ] || fail "local-only file staged:"$'\n'"$bad"

python3 tools/check_no_game_data.py --staged || fail "game data check failed"

tmp_parent=${TMPDIR:-/tmp}
tmp=$(mktemp -d "$tmp_parent/pb-precommit.XXXXXXXX")
cleanup_tmp() {
    if [[ "$tmp" != "$tmp_parent"/pb-precommit.* ]]; then
        echo "pre-commit: refusing to clean unexpected temporary path: $tmp" >&2
        return 1
    fi
    [ ! -d "$tmp" ] || rm -r -- "$tmp"
}
trap cleanup_tmp EXIT
git checkout-index -a --prefix="$tmp/"
python3 "$tmp/tools/validate_functions.py" --root "$tmp" || fail "functions.csv / hooks.csv validation failed"
python3 "$tmp/tools/progress.py" --root "$tmp" --check \
    || fail "README progress block is stale: run tools/progress.py --update-readme and stage README.md"
# check_catalogue derives ROOT from its own __file__, so the copy under $tmp checks the STAGED tree.
if [ -f "$tmp/tools/check_catalogue.py" ]; then
    python3 "$tmp/tools/check_catalogue.py" \
        || fail "catalogue parses: raw csv.DictReader outside the allowlist, or a stale entry"
fi
if [ -f "$tmp/tools/check_readable.py" ]; then
    # the list may only shrink against HEAD's (when HEAD has one: not on the commit introducing it)
    base=()
    if git show HEAD:tools/readable_allowlist.txt >"$tmp/.readable_base" 2>/dev/null; then
        base=(--base-list "$tmp/.readable_base")
    fi
    python3 "$tmp/tools/check_readable.py" --root "$tmp" "${base[@]}" \
        || fail "game/ is not readable (STYLE.md): see the lines above"
fi
exit 0
